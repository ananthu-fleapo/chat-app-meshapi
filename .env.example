# ── Environment ───────────────────────────────────────────────────────────────
# "dev" → pretty logs, /docs enabled, DEBUG level
# "prod" → JSON logs (GCP Cloud Logging format), /docs disabled, INFO level
ENV=dev
LOG_LEVEL=INFO

# ── Server ────────────────────────────────────────────────────────────────────
# Cloud Run sets PORT automatically; leave as 8000 for local dev.
PORT=8000

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_S=120.0

# ── Database (Phase 2) ────────────────────────────────────────────────────────
# Local dev:
# DATABASE_URL=postgresql+asyncpg://routersvc:routersvc@localhost:5432/routersvc
#
# GCP Cloud Run + Cloud SQL (Unix socket via Cloud SQL Auth Proxy):
# DATABASE_URL=postgresql+asyncpg://routersvc:PASSWORD@/routersvc?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# ── Redis (Phase 2) ───────────────────────────────────────────────────────────
# Local dev:
# REDIS_URL=redis://localhost:6379/0
#
# GCP Memorystore (private VPC IP, no TLS on internal network):
# REDIS_URL=redis://10.x.x.x:6379/0
REDIS_URL=

# ── Webhook auth ──────────────────────────────────────────────────────────────
# Static secret for inbound webhook calls (e.g. payment provider callbacks).
# Requests must pass: Authorization: Bearer <value>
WEBHOOK_API_KEY=

# ── GCP (Phase 7+) ────────────────────────────────────────────────────────────
GCP_PROJECT_ID=

# For fetching live exchange rates
EXCHANGE_RATE_API_URL=
